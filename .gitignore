# Local notes with this PC's paths
docs/local.md
.claude/settings.local.json

# The original game files: kept out of the public history (SHA-256 in NOTES.md)
original/
# Patched builds contain the whole original too; scripts/build.py makes them again
patched/*.swf
# AIR apps made from them (scripts/package_air.py), with the AIR runtime
patched/air/

# Downloaded tools (ffdec, Ruffle, Flash Player projector)
tools/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/

# ffdec output (decompiled/<name>/): only scripts, texts, binaryData (level data)
# and the symbol list are tracked. Exported media (images, sounds, fonts, frames...)
# is bulky and can be exported again from original/. An allowlist, so a code
# package named "sounds" or a new media type can't slip past it.
decompiled/*/*
!decompiled/*/scripts/
!decompiled/*/texts/
!decompiled/*/binaryData/
!decompiled/*/symbolClass/
# Temporary export folder of scripts/decompile.py
decompiled/*.new/

# Screenshots and temp output from test runs
screenshots/
*.tmp
*.log

# Windows
Thumbs.db
desktop.ini
